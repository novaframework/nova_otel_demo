{erl_opts, [debug_info]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{shell, [{config, "./config/dev_sys.config"}, {apps, [nova_otel_demo]}]}.

{deps, [
    {nova, "~> 0.18"},
    {cowlib, "2.21.0"},
    {opentelemetry, "~> 1.7"},
    {opentelemetry_experimental, "~> 0.6"},
    {opentelemetry_exporter, "~> 1.11"},
    {opentelemetry_nova, "~> 0.5"}
]}.

{ct_opts, [{sys_config, ["config/dev_sys.config"]}]}.

{project_plugins, [
    {rebar3_nova, {git, "https://github.com/novaframework/rebar3_nova.git", {tag, "v0.14.0"}}}
]}.
